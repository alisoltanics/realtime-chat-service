# ---- Django / API -----------------------------------------------------------
DJANGO_SECRET_KEY=generate-with-python-secrets-token-urlsafe-48
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*
DJANGO_API_PORT=8000
LOG_LEVEL=INFO
JWT_ACCESS_MINUTES=30

# ---- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=chat
POSTGRES_USER=chat
POSTGRES_PASSWORD=chat
POSTGRES_PORT_HOST=5433

# ---- Realtime (Socket.IO) --------------------------------------------------
REALTIME_PORT=4000
MAX_MESSAGE_LENGTH=4000
RATE_LIMIT_WINDOW_MS=10000
RATE_LIMIT_MAX_MESSAGES=20
PRESENCE_TTL_MS=90000
PRESENCE_SWEEP_INTERVAL_MS=15000

# ---- Frontend ---------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
VITE_SOCKET_URL=http://localhost:4000

# ---- Shared ----------------------------------------------------------------
# Secret shared between Django and the realtime service; the realtime service
# presents it as X-Service-Token on the /api/internal/* endpoints.
INTERNAL_SERVICE_TOKEN=change-me-in-production
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
SEED_DEMO_DATA=false